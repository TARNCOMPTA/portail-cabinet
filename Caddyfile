# HTTPS automatique (Let's Encrypt) pour le portail.
# Domaine et e-mail injectés par docker-compose (variables DOMAIN / ACME_EMAIL du .env),
# avec repli sur les valeurs par défaut ci-dessous.
{
	email {$ACME_EMAIL:aymeric@tarncompta.fr}
}

{$DOMAIN:portail.tarncompta.fr} {
	# Compression : Caddy ne compresse RIEN par defaut. Sans cette directive, le
	# chargement de l'interface transferait 390 Ko de HTML/CSS/JS au lieu de 73 Ko,
	# et les reponses JSON de l'API (listes de documents) partaient brutes.
	# zstd d'abord (meilleur ratio), gzip en repli pour les vieux navigateurs.
	# Les .woff2 et les PDF sont deja compresses : Caddy les ignore automatiquement.
	encode zstd gzip

	# Vue du navigateur du serveur (noVNC) pour saisir la captcha — protégée par la session
	# du portail : Caddy vérifie le cookie auprès de /api/me avant de laisser passer.
	handle_path /vnc/* {
		forward_auth app:3000 {
			uri /api/me
		}
		reverse_proxy app:6080
	}

	reverse_proxy app:3000
}
